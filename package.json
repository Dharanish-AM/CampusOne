{
  "name": "campusone-root",
  "version": "1.0.0",
  "description": "Root package for CampusOne monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend-web",
    "frontend-mobile",
    "data-server"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "npx prettier --check .",
    "test:backend": "npm --prefix backend run test",
    "check:builds": "npm --prefix frontend-web run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1"
  }
}
